datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DrumExercise {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String   // "Rudimentos", "Grooves", "Independencia", "Acentos & Síncopas"
  difficulty    String   // "Básico", "Intermedio", "Avanzado"
  bpmDefault    Int      @default(100)
  timeSignature String   @default("4/4")
  totalSteps    Int      @default(16) // Subdivisión base (ej. 16 semicorcheas por compás)
  hitsData      Json     // Array estructurado con notas, duraciones, articulaciones y sticking
  createdAt     DateTime @default(now())
}

model StringExercise {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  instrument    String   // "bass_4" | "guitar_6"
  tuning        String   @default("Standard") // Ej: "E A D G" o "E A D G B E"
  category      String   // "Slap & Pop", "Walking Bass", "Escalas & Arpegios", "Licks & Riffs", "Fingerpicking"
  difficulty    String   // "Básico", "Intermedio", "Avanzado"
  bpmDefault    Int      @default(90)
  timeSignature String   @default("4/4")
  totalSteps    Int      @default(16) // Subdivisión de compás
  tabData       Json     // Array con notas de tablatura (cuerda, traste, técnica, duración)
  createdAt     DateTime @default(now())
}

model CustomScalePattern {
  id             String   @id @default(cuid())
  instrumentType String   // "guitar_6", "bass_4", "bass_5"
  system         String   // "caged", "3nps"
  scaleKey       String   // "major", "pentatonic_minor", "dorian", "blues", etc.
  patternId      Int      // 1 al 5 (CAGED) o 1 al 7 (3NPS)
  name           String
  minFret        Int
  maxFret        Int
  notesData      Json     // Array de objetos: { stringIndex: number, fret: number, finger: number, isRoot: boolean, isStretch?: boolean }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([instrumentType, system, scaleKey, patternId], name: "pattern_unique_identifier")
  @@index([instrumentType, system, scaleKey])
}

model CustomChordVoicing {
  id          String   @id @default(cuid())
  instrument  String   @default("guitar_6c") // "guitar_6c" | "bass_4c" | "bass_5c"
  root        String   // ej. "C"
  chordType   String   // ej. "major", "m7", "maj7"
  shape       String   // ej. "C", "A", "G", "E", "D" o identificador de voicing
  fretsJson   Json     // Array con las notas/trastes por cuerda: [{ stringIndex: 0, fret: 3, note: "C", isRoot: true }, ...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([instrument, root, chordType, shape], name: "chord_unique_identifier")
}

model CustomProgression {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("Personalizada")
  chordsJson  Json     // Array de objetos: [{ degreeLabel: "ii7", bars: 2, assignedImprovResourceId: "minor_pentatonic" }, ...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
